node_modules/
.venv/
__pycache__/

# Env files may hold real credentials; .env.example is the only one meant to be committed.
.env
.env.*
!.env.example

# Local cache of what's already been pushed to Supabase Storage — ephemeral, regenerable.
scripts/upload-manifest.json

# extract.py's raw, pre-metric output — a throwaway intermediate, not the documented schema.
# recipes_metric.json (the real source of truth) stays tracked.
/recipes.json
/report.json
scripts/tag-report.txt

# repair_sections.py's output — regenerable from recipes_metric.json in one run,
# and 42MB, so it's treated like /recipes.json rather than tracked. The bundle it
# feeds (app/public/data/recipes.json) is what actually ships and stays tracked.
/recipes_repaired.json
/section-repair-report.txt
